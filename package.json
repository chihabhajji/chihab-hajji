{
  "name": "nextjs-sanity-starter",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "test:ui": "turbo run test --filter=@sbt/ui",
    "prepare": "turbo run prepare"
  },
  "devDependencies": {
    "prettier": "latest",
    "turbo": "^2.5.0"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "dotenv-cli": "^7.0.0"
  }
}
